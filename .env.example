# Скопируйте в .env.local и заполните. .env.local в git не попадает.

# Turso: `turso db show salary --url` и `turso db tokens create salary`
# Для локальной разработки достаточно: TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Better Auth: секрет — `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (необязательно — без них кнопка «Войти через Google» скрыта)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
